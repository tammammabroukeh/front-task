# FakeStoreAPI base URL (no trailing slash required)
BASE_URL=https://fakestoreapi.com

# Fetch timeout in milliseconds (optional; defaults to 15000)
NEXT_PUBLIC_API_TIMEOUT=15000

# NextAuth (added in the auth task)
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Demo admin credentials (Credentials provider)
ADMIN_EMAIL=admin@fakestore.dev
ADMIN_PASSWORD=admin1234
